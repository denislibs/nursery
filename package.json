{
  "name": "nursery-monorepo",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt packages test scripts vitest.config.ts tsconfig.json tsconfig.base.json package.json svelte.config.js",
    "format:check": "oxfmt --check packages test scripts vitest.config.ts tsconfig.json tsconfig.base.json package.json svelte.config.js",
    "lint": "oxlint packages test scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project node",
    "build": "npm run build -w @nursery/core && npm run build -w @nursery/react -w @nursery/vue -w @nursery/solid -w @nursery/svelte -w @nursery/angular",
    "check:types-consumer": "node scripts/check-consumer-types.mjs",
    "check:pkg": "node scripts/check-packages.mjs",
    "check:cookbook": "node scripts/check-cookbook.mjs && node scripts/check-cookbook-compile.mjs",
    "size": "size-limit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:cookbook && npm test && npm run build && npm run check:types-consumer && npm run check:pkg && npm run size",
    "docs:api": "npm --prefix docs/api install --no-audit --no-fund && npm --prefix docs/api run build",
    "example": "npm --prefix examples/playground install --no-audit --no-fund && npm --prefix examples/playground run dev",
    "showcase": "npm --prefix examples/showcase install --no-audit --no-fund && npm --prefix examples/showcase run dev"
  },
  "devDependencies": {
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser-playwright": "^5.0.0",
    "esbuild": "^0.25.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "size-limit": "^13.0.3",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  },
  "size-limit": [
    {
      "name": "@nursery/core/nursery { Nursery }",
      "path": "packages/core/dist/nursery.js",
      "import": "{ Nursery }",
      "limit": "3 kB"
    },
    {
      "name": "@nursery/core/iter { debounce }",
      "path": "packages/core/dist/iter.js",
      "import": "{ debounce }",
      "limit": "1 kB"
    },
    {
      "name": "@nursery/core/signal { sleep }",
      "path": "packages/core/dist/signal.js",
      "import": "{ sleep }",
      "limit": "400 B"
    },
    {
      "name": "@nursery/core/http { createHttp }",
      "path": "packages/core/dist/http.js",
      "import": "{ createHttp }",
      "limit": "4 kB"
    },
    {
      "name": "@nursery/core (everything)",
      "path": "packages/core/dist/index.js",
      "limit": "12.5 kB"
    }
  ],
  "engines": {
    "node": ">=22"
  }
}
