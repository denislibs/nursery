{
  "name": "scopekit",
  "version": "0.1.0",
  "description": "Structured concurrency, cancellation and concurrency-limit utilities for the browser",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project node",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denislibs/scopekit.git"
  },
  "homepage": "https://github.com/denislibs/scopekit#readme",
  "bugs": {
    "url": "https://github.com/denislibs/scopekit/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
