{
  "name": "@nursery/svelte",
  "version": "1.0.0-rc.1",
  "description": "Svelte 5 helpers for @nursery/core: scoped effects, async state, latest-wins calls, event streams and workers tied to the component lifecycle.",
  "keywords": [
    "abortsignal",
    "cancellation",
    "nursery",
    "structured-concurrency",
    "svelte"
  ],
  "homepage": "https://github.com/denislibs/nursery#readme",
  "bugs": {
    "url": "https://github.com/denislibs/nursery/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denislibs/nursery.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/postbuild.mjs svelte",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nursery/core": "^1.0.0-rc.1",
    "svelte": ">=5"
  },
  "engines": {
    "node": ">=22"
  }
}
